<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/countdownSquare"
        android:layout_width="109dp"
        android:layout_height="109dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/rounded_countdown_time_bg"
        tools:layout_editor_absoluteX="151dp" />

    <ImageView
        android:id="@+id/pillarLeft"
        android:layout_width="64dp"
        android:layout_height="134dp"
        android:layout_marginEnd="76dp"
        app:layout_constraintBottom_toBottomOf="@+id/countdownSquare"
        app:layout_constraintEnd_toEndOf="@+id/countdownSquare"
        app:layout_constraintTop_toTopOf="@+id/countdownSquare"
        app:layout_constraintVertical_bias="0.48"
        app:srcCompat="@drawable/countdown_pillar_svg" />

    <ImageView
        android:id="@+id/pillarRight"
        android:layout_width="64dp"
        android:layout_height="134dp"
        android:layout_marginStart="76dp"
        app:layout_constraintBottom_toBottomOf="@+id/countdownSquare"
        app:layout_constraintStart_toStartOf="@+id/countdownSquare"
        app:layout_constraintTop_toTopOf="@+id/countdownSquare"
        app:layout_constraintVertical_bias="0.48"
        app:srcCompat="@drawable/countdown_pillar_svg" />
</androidx.constraintlayout.widget.ConstraintLayout>