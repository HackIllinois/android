<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.leaderboard.LeaderboardFragment"
    android:background="@drawable/point_shop_gradient_background">

    <ImageView
        android:id="@+id/image_view_girl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_girl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.82"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/image_view_counter"
        app:layout_constraintVertical_bias="0.34" />

    <ImageView
        android:id="@+id/image_view_cloud_side"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_cloud_side"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        android:rotation="2.7"
        app:layout_constraintTop_toTopOf="@id/image_view_counter"
        app:layout_constraintVertical_bias="0.30"/>

    <ImageView
        android:id="@+id/image_view_cart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_cart_symbol"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.452" />

    <ImageView
        android:id="@+id/image_view_cloud_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="2.73"
        android:src="@drawable/point_shop_cloud_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.04" />

    <ImageView
        android:id="@+id/image_view_counter"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:src="@drawable/point_shop_counter"
        android:scaleType="fitXY"
        android:layout_marginTop="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_textview_point_shop" />

    <ImageView
        android:id="@+id/image_view_counter_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@drawable/point_shop_counter_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <ImageView
        android:id="@+id/image_view_counter_middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_counter_middle"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintBottom_toTopOf="@id/image_view_counter_bottom"
        app:layout_constraintTop_toBottomOf="@id/image_view_girl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/image_view_sticker1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_sticker"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.204"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.636" />

    <ImageView
        android:id="@+id/image_view_sticker2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_sticker"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.777"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.636" />

    <ImageView
        android:id="@+id/image_view_sticker1_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_sticker_symbol"
        app:layout_constraintStart_toStartOf="@id/image_view_sticker1"
        app:layout_constraintEnd_toEndOf="@id/image_view_sticker1"
        app:layout_constraintBottom_toBottomOf="@id/image_view_sticker1"
        app:layout_constraintTop_toTopOf="@id/image_view_sticker1" />

    <ImageView
        android:id="@+id/image_view_sticker2_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_sticker_symbol"
        app:layout_constraintStart_toStartOf="@id/image_view_sticker2"
        app:layout_constraintEnd_toEndOf="@id/image_view_sticker2"
        app:layout_constraintBottom_toBottomOf="@id/image_view_sticker2"
        app:layout_constraintTop_toTopOf="@id/image_view_sticker2" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/image_view_sticker3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker"
            app:layout_constraintWidth_percent="0.3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/image_view_sticker4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.9"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <ImageView
            android:id="@+id/image_view_sticker4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker"
            app:layout_constraintWidth_percent="0.3"
            app:layout_constraintVertical_bias="0.9"
            app:layout_constraintStart_toEndOf="@id/image_view_sticker3"
            app:layout_constraintEnd_toStartOf="@id/image_view_sticker5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_view_sticker5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker"
            app:layout_constraintWidth_percent="0.3"
            app:layout_constraintVertical_bias="0.9"
            app:layout_constraintStart_toEndOf="@id/image_view_sticker4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/image_view_sticker4_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker3"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker5"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker4"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker4" />

        <ImageView
            android:id="@+id/image_view_sticker3_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker3"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker3"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker3"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker3" />

        <ImageView
            android:id="@+id/image_view_sticker5_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker5"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker5"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker5"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker5" />


    </androidx.constraintlayout.widget.ConstraintLayout>




    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="44dp" />

    <TextView
        android:id="@+id/title_textview_point_shop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:textSize="24sp"
        android:gravity="start"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineTop"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/black"
        android:text="@string/pointshop" />

    <TextView
        android:id="@+id/number_of_coins_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/point_shop_coin_background"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/coin_imageview"
        app:layout_constraintTop_toTopOf="@id/number_of_coins_textview"
        app:layout_constraintEnd_toEndOf="@id/number_of_coins_textview"
        app:layout_constraintBottom_toBottomOf="@id/number_of_coins_textview"
        android:visibility="invisible"/>

    <ImageView
        android:id="@+id/coin_imageview"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="2dp"
        android:layout_marginVertical="3dp"
        android:paddingStart="7dp"
        android:src="@drawable/point_shop_currency"
        app:layout_constraintEnd_toStartOf="@id/number_of_coins_textview"
        app:layout_constraintTop_toTopOf="@id/number_of_coins_textview"
        app:layout_constraintBottom_toBottomOf="@id/number_of_coins_textview"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/number_of_coins_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="45dp"
        android:fontFamily="@font/montserrat_semi_bold"
        android:paddingTop="1dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintVertical_bias="0.75"
        app:layout_constraintBottom_toBottomOf="@id/title_textview_point_shop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_textview_point_shop"
        android:text="@string/blank"
        android:visibility="invisible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview_point_shop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.075"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/merchButton"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/merchButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="53dp"
        android:background="@drawable/point_shop_selected_background"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:textColor="@color/claret"
        android:textSize="16sp"
        android:paddingBottom="1.5dp"
        app:layout_constraintEnd_toStartOf="@+id/guidelineSeparator"
        app:layout_constraintStart_toStartOf="@+id/recyclerview_point_shop"
        app:layout_constraintTop_toTopOf="@id/image_view_counter"
        android:text="@string/merch" />

    <TextView
        android:id="@+id/raffleButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="53dp"
        android:background="@drawable/point_shop_unselected_background"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:textColor="@color/claret"
        android:textSize="16sp"
        android:paddingBottom="1.5dp"
        app:layout_constraintEnd_toEndOf="@+id/recyclerview_point_shop"
        app:layout_constraintStart_toStartOf="@+id/guidelineSeparator"
        app:layout_constraintTop_toTopOf="@id/image_view_counter"
        android:text="@string/raffle" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

</androidx.constraintlayout.widget.ConstraintLayout>