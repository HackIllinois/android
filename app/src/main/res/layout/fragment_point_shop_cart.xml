<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >


    <ImageView
        android:id="@+id/image_view_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/point_shop_cart_bg"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/title_textview_point_shop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:text="@string/cart"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintVertical_bias="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1" />


    <TextView
        android:id="@+id/number_of_coins_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/point_shop_coin_background"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/coin_imageview"
        app:layout_constraintTop_toTopOf="@id/number_of_coins_textview"
        app:layout_constraintEnd_toEndOf="@id/number_of_coins_textview"
        app:layout_constraintBottom_toBottomOf="@id/number_of_coins_textview"
        android:visibility="invisible"/>

    <ImageView
        android:id="@+id/coin_imageview"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginEnd="2dp"
        android:layout_marginVertical="3dp"
        android:paddingStart="7dp"
        android:src="@drawable/point_shop_currency"
        app:layout_constraintEnd_toStartOf="@id/number_of_coins_textview"
        app:layout_constraintTop_toTopOf="@id/number_of_coins_textview"
        app:layout_constraintBottom_toBottomOf="@id/number_of_coins_textview"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/number_of_coins_textview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="45dp"
        android:fontFamily="@font/montserrat_semi_bold"
        android:paddingTop="1dp"
        android:paddingEnd="10dp"
        android:paddingBottom="3dp"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintVertical_bias="0.75"
        app:layout_constraintBottom_toBottomOf="@id/title_textview_point_shop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_textview_point_shop"
        android:text="@string/blank"
        android:visibility="invisible"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/image_view_sticker1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker"
            android:adjustViewBounds="true"
            android:layout_marginStart="16dp"
            app:layout_constraintWidth_percent="0.4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/image_view_sticker2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.2"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <ImageView
            android:id="@+id/image_view_sticker2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:src="@drawable/point_shop_sticker"
            android:adjustViewBounds="true"
            app:layout_constraintWidth_percent="0.4"
            app:layout_constraintVertical_bias="0.2"
            app:layout_constraintStart_toEndOf="@id/image_view_sticker1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <ImageView
            android:id="@+id/image_view_sticker1_symbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.13"
            app:layout_constraintHeight_percent="0.13"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker1"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker1"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker1"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker1" />

        <ImageView
            android:id="@+id/image_view_sticker2_symbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.13"
            app:layout_constraintHeight_percent="0.13"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker2"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker2"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker2"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker2" />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/image_view_sticker3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:src="@drawable/point_shop_sticker"
            android:adjustViewBounds="true"
            app:layout_constraintWidth_percent="0.4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/image_view_sticker4"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.55"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <ImageView
            android:id="@+id/image_view_sticker4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker"
            android:adjustViewBounds="true"
            android:layout_marginEnd="16dp"
            app:layout_constraintWidth_percent="0.4"
            app:layout_constraintVertical_bias="0.55"
            app:layout_constraintStart_toEndOf="@id/image_view_sticker3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <ImageView
            android:id="@+id/image_view_sticker3_symbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.13"
            app:layout_constraintHeight_percent="0.13"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker3"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker3"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker3"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker3" />

        <ImageView
            android:id="@+id/image_view_sticker4_symbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.13"
            app:layout_constraintHeight_percent="0.13"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker4"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker4"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker4"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker4" />



    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/image_view_sticker5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker"
            android:layout_marginStart="16dp"
            android:adjustViewBounds="true"
            app:layout_constraintWidth_percent="0.4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/image_view_sticker6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.91"
            app:layout_constraintHorizontal_chainStyle="spread" />

        <ImageView
            android:id="@+id/image_view_sticker6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/point_shop_sticker"
            android:adjustViewBounds="true"
            android:layout_marginEnd="16dp"
            app:layout_constraintWidth_percent="0.4"
            app:layout_constraintVertical_bias="0.91"
            app:layout_constraintStart_toEndOf="@id/image_view_sticker5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <ImageView
            android:id="@+id/image_view_sticker6_symbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.13"
            app:layout_constraintHeight_percent="0.13"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker6"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker6"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker6"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker6" />

        <ImageView
            android:id="@+id/image_view_sticker5_symbol"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.13"
            app:layout_constraintHeight_percent="0.13"
            android:src="@drawable/point_shop_sticker_symbol"
            app:layout_constraintStart_toStartOf="@id/image_view_sticker5"
            app:layout_constraintEnd_toEndOf="@id/image_view_sticker5"
            app:layout_constraintBottom_toBottomOf="@id/image_view_sticker5"
            app:layout_constraintTop_toTopOf="@id/image_view_sticker5" />



    </androidx.constraintlayout.widget.ConstraintLayout>






</androidx.constraintlayout.widget.ConstraintLayout>